DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
APP_ENV=development
API_JWT_SECRET=your_jwt_secret_here

# UPSTASH_REDIS (checkout reservation coordination)
# Required for POST /api/v1/inventory/reservations. Missing or unusable values
# fail the endpoint closed (503 ERR_COORDINATION_UNAVAILABLE) without changing
# inventory. The token is sent only as an HTTP Authorization header and is never
# logged or returned. Never commit real values to this file.
REDIS_REST_URL=
REDIS_REST_TOKEN=

# OPENTELEMETRY TRACING (opt-in, disabled by default)
# With OTEL_TRACING_ENABLED=false no exporter, background worker, pgx tracer, or
# tracing middleware is created, and no trace data leaves the process. When
# enabled, structurally invalid configuration fails startup with a safe
# field-level error that never echoes header values or credentials.
# No Jaeger, OpenTelemetry Collector, storage, or trace UI is required: automated
# verification uses a temporary local OTLP/HTTP capture receiver.
# The values below are the disabled safe defaults; replace the endpoint and
# headers with your own placeholders in real deployments.
OTEL_TRACING_ENABLED=false

# Resource identity. OTEL_SERVICE_NAME defaults to gin-product-service.
OTEL_SERVICE_NAME=gin-product-service
# Required when enabled; falls back to APP_ENV when unset.
OTEL_DEPLOYMENT_ENVIRONMENT=

# OTLP/HTTP trace destination. Absolute http/https URL with a host and no user
# info, query, or fragment, e.g. https://your-otel-endpoint.example/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional OTLP headers, e.g. authorization=Bearer <placeholder>. Parsed without
# echoing values; never logged and never exported as trace data.
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
# gzip | none
OTEL_EXPORTER_OTLP_TRACES_COMPRESSION=gzip
# Milliseconds; must be positive and within the 15s service shutdown budget.
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=5000

# Decimal in [0,1]. Applies only when this service starts a new root trace; a
# valid upstream sampling decision is always honored.
OTEL_TRACES_SAMPLER_ARG=0.10

# Bounded buffering: batch size must be positive and no larger than the queue
# size; when the queue is full, newly completed spans are dropped (and counted)
# instead of delaying a request. Durations are milliseconds.
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_EXPORT_TIMEOUT=5000
# Must be positive and strictly below the 15s service shutdown budget.
OTEL_TRACES_SHUTDOWN_TIMEOUT=5000

# Default deny: empty means no baggage key is extracted or injected. Only the
# listed keys may be propagated downstream; baggage never becomes span/log data.
OTEL_BAGGAGE_ALLOWLIST=